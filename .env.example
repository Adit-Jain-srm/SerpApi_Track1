# Copy this file to .env and fill in the values. Never commit .env.
#
#   Windows (PowerShell): Copy-Item .env.example .env
#   Windows (cmd):        copy .env.example .env
#   Unix:                 cp .env.example .env

# Required for Azure OpenAI extraction.
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-5.3-chat

# Required. SerpApi dashboard: https://serpapi.com/manage-api-key
# This repo reads SERPAPI_API_KEY only.
SERPAPI_API_KEY=

# Optional. Leave empty to print the console summary and skip Teams.
TEAMS_WEBHOOK_URL=

# Optional Slack digest beside Teams. Leave the bot token or channel empty to skip Slack.
# SLACK_APP_TOKEN is stored for later socket mode and is not used for posting.
# SLACK_CHANNEL_ID is the channel ID (not the name) after the bot is invited.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_CHANNEL_ID=

# Optional tunables. Defaults match config/constants.py.
SEARCH_DAYS=7
BATCH_SIZE=4
LLM_CONCURRENCY_LIMIT=2

# The public site (Vercel project root: web/) takes one variable, set in the
# Vercel project, not in this file: SERPAPI_API_KEY.
# Do not put the Azure, Teams, or Slack values on Vercel.
